COMMAND_MCP_HOST=127.0.0.1
COMMAND_MCP_PORT=8000
# Leave empty to have the server generate a random key in this file.
COMMAND_MCP_API_KEY=
COMMAND_MCP_AUTH_ENABLED=true
COMMAND_MCP_ENV_FILE=.env
COMMAND_MCP_LOG_LEVEL=INFO
COMMAND_MCP_MODULES=command_mcp.commands.core
COMMAND_MCP_READ_ROOTS=.
COMMAND_MCP_ALLOW_UNAUTHENTICATED_REMOTE=false
COMMAND_MCP_ALLOW_SENSITIVE_FILE_READS=false
